# Air API SDK environment variables
#
# Copy this file to `.env.test` and fill in real credentials to run e2e tests.
# `AIR_API_KEY` and `AIR_ACCESS_TOKEN` are mutually exclusive — set exactly one.

# API key authentication (workspace-scoped)
AIR_API_KEY=
AIR_WORKSPACE_ID=

# OAuth bearer authentication (used by discovery endpoints like GET /v1/workspaces)
# AIR_ACCESS_TOKEN=

# Base URL override. Defaults to https://api.air.inc/v1 when unset.
# Point this at the QA environment when running e2e tests against QA.
# AIR_API_BASE_URL=

# OAuth client credentials (when AIR_E2E_AUTH_MODE=oauth)
# AIR_OAUTH_CLIENT_ID=
# AIR_OAUTH_CLIENT_SECRET=
# AIR_OAUTH_TOKEN_URL=

# E2E auth mode: "apikey" (default) or "oauth"
# AIR_E2E_AUTH_MODE=
