{
  "name": "@air/api-rest",
  "version": "0.2.0",
  "type": "module",
  "description": "Typed REST client for Air API",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepublishOnly": "npm run build",
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "clean": "rm -rf dist .tsc-out tsconfig.tsbuildinfo"
  },
  "devDependencies": {
    "@air/api-core": "0.2.0"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AirLabsTeam/air-api-sdk.git",
    "directory": "packages/rest"
  },
  "license": "MIT"
}
